.DS_Store
node_modules/
.env
.env.local
*.log
.rsc/
# .claude/ is the same kind of thing as .rsc/: wiring rsc GENERATES for this machine —
# settings.json with absolute paths, symlinked skill dirs, the installed developer agent.
# Left untracked-but-not-ignored it also makes rsc's own ship-guard treat every rsc-wired
# repo as having an abandoned diff, which blocks switching branches.
.claude/

# Per-tool ignores already exist inside each skill's _TEMPLATE/.gitignore.

# build artifacts
.coverage
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Working documentation lives in the RSC container, NOT here.
# This repo stays clean so whoever clones it starts coding, not reading.
# Migrated 2026-09-04 to https://github.com/ericrisco/RSC → 02-DOCS/
#   docs/        -> RSC 02-DOCS/raw/migrated/docs/
#   skill-build/ -> RSC 02-DOCS/raw/migrated/skill-build/
#   02-DOCS/     -> RSC 02-DOCS/ (wiki/sdd, wiki/brand, wiki/stack, raw/…)
# The contributor-facing standard stays in this repo: scripts/skill-rubric.md.
# El fork versiona su propia documentacion en docs/fork/; el resto de docs/ sigue ignorado.
docs/*
!docs/fork/
skill-build/
02-DOCS/

node_modules/
coverage/

# Worktrees created for isolated feature work — the directory is scratch, never content.
.worktrees/

# Upstream maintenance scratch (§9): the disposable worktrees `--worktree` creates and the
# disposable project/home the gate installs into. REQUIREMENTS §1 keeps those writes inside the
# dedicated folder, which means inside the repository, which means they have to be ignored or every
# maintenance run dirties `git status`. The journal and the report are NOT here: they live under
# `docs/fork/stage5/runs/`, because the evidence of what was incorporated is committed.
.rsc-upstream/
